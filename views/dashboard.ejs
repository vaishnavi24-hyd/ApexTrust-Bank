<%- include('partials/header') %>

<div class="container my-4">
  
  <!-- Welcome and Alert Header -->
  <div class="row align-items-center mb-4 gy-2">
    <div class="col-md-8">
      <span class="badge bg-success-light text-success fw-bold px-3 py-2 rounded-pill mb-2">
        <i class="bi bi-patch-check-fill me-1"></i> Account Active
      </span>
      <h2 class="fw-bold text-dark mb-0">Welcome back, <%= user.fullname %></h2>
      <p class="text-muted small mb-0">
        Account: <span class="fw-medium text-dark">#1029-4829-<%= String(user.id).padStart(4, '0') %></span> &bull; Last access: <span class="fw-medium text-dark">Today at 18:45 (IP: 192.168.1.42)</span>
      </p>
    </div>
    <div class="col-md-4 text-md-end">
      <!-- Session quick indicator -->
      <span class="d-inline-flex align-items-center bg-white border px-3 py-2 rounded-3 shadow-sm text-success small fw-medium">
        <span class="spinner-grow spinner-grow-sm text-success me-2" role="status" style="width: 10px; height: 10px;"></span>
        Session Encrypted
      </span>
    </div>
  </div>

  <% if (typeof locals.extended !== 'undefined' || (typeof query !== 'undefined' && query.extended)) { %>
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4 rounded-3 small" role="alert">
      <i class="bi bi-shield-check-fill me-2 fs-5"></i>
      <div>Your secure banking session has been extended successfully.</div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4 rounded-3 small" role="alert">
      <i class="bi bi-check-circle-fill me-2 fs-5"></i>
      <div><%= success %></div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4 rounded-3 small" role="alert">
      <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
      <div><%= error %></div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <!-- Dashboard Grid -->
  <div class="row g-4">
    
    <!-- Left Column (Balance, Actions, Transactions) -->
    <div class="col-lg-8">
      
      <!-- Balance Card Section -->
      <div class="card card-premium balance-card p-4 mb-4">
        <div class="row align-items-center">
          <div class="col-md-8">
            <span class="card-subtitle uppercase small text-uppercase"><%= user.account_type.charAt(0).toUpperCase() + user.account_type.slice(1) %> Account Balance</span>
            <h1 class="balance-amount my-2">$<%= parseFloat(user.balance).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></h1>
            <p class="mb-0 text-light-gray small">
              Available Funds: <span class="text-white fw-bold">$<%= parseFloat(user.balance).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span> &bull; Ledger Balance: <span class="text-white">$<%= parseFloat(user.balance).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
            </p>
          </div>
          <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <span class="fs-1 text-white opacity-25">
              <i class="bi bi-credit-card-2-front-fill"></i>
            </span>
          </div>
        </div>
      </div>

      <!-- Secure Transaction Terminal -->
      <h5 class="fw-bold text-primary mb-3">Secure Transaction Terminal</h5>
      <div class="card card-premium p-4 mb-4">
        <ul class="nav nav-pills nav-fill mb-3" id="transactionTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active fw-semibold" id="deposit-tab" data-bs-toggle="pill" data-bs-target="#deposit-pane" type="button" role="tab" aria-controls="deposit-pane" aria-selected="true">
              <i class="bi bi-wallet2 me-2"></i>Deposit
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold" id="withdraw-tab" data-bs-toggle="pill" data-bs-target="#withdraw-pane" type="button" role="tab" aria-controls="withdraw-pane" aria-selected="false">
              <i class="bi bi-cash-stack me-2"></i>Withdrawal
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold" id="transfer-tab" data-bs-toggle="pill" data-bs-target="#transfer-pane" type="button" role="tab" aria-controls="transfer-pane" aria-selected="false">
              <i class="bi bi-arrow-left-right me-2"></i>Wire Transfer
            </button>
          </li>
        </ul>

        <div class="tab-content" id="transactionTabsContent">
          <!-- Deposit Pane -->
          <div class="tab-pane fade show active" id="deposit-pane" role="tabpanel" aria-labelledby="deposit-tab">
            <form action="/transactions/deposit" method="POST" class="needs-validation" novalidate>
              <div class="form-floating mb-3">
                <input type="number" step="0.01" min="0.01" class="form-control" id="depositAmount" name="amount" placeholder="0.00" required>
                <label for="depositAmount">Deposit Amount ($)</label>
                <div class="invalid-feedback">Please enter a valid deposit amount (greater than 0).</div>
              </div>
              <button type="submit" class="btn btn-primary-custom w-100 py-2 d-flex align-items-center justify-content-center">
                <i class="bi bi-check-circle-fill me-2"></i> Submit Deposit
              </button>
            </form>
          </div>

          <!-- Withdraw Pane -->
          <div class="tab-pane fade" id="withdraw-pane" role="tabpanel" aria-labelledby="withdraw-tab">
            <form action="/transactions/withdraw" method="POST" class="needs-validation" novalidate>
              <div class="form-floating mb-3">
                <input type="number" step="0.01" min="0.01" max="<%= user.balance %>" class="form-control" id="withdrawAmount" name="amount" placeholder="0.00" required>
                <label for="withdrawAmount">Withdrawal Amount ($)</label>
                <div class="invalid-feedback">Please enter a valid withdrawal amount (not exceeding your balance).</div>
              </div>
              <button type="submit" class="btn btn-primary-custom w-100 py-2 d-flex align-items-center justify-content-center">
                <i class="bi bi-cash-stack me-2"></i> Submit Withdrawal
              </button>
            </form>
          </div>

          <!-- Transfer Pane -->
          <div class="tab-pane fade" id="transfer-pane" role="tabpanel" aria-labelledby="transfer-tab">
            <form action="/transactions/transfer" method="POST" class="needs-validation" novalidate>
              <div class="form-floating mb-3">
                <input type="email" class="form-control" id="transferEmail" name="recipientEmail" placeholder="recipient@example.com" required>
                <label for="transferEmail">Recipient Email Address</label>
                <div class="invalid-feedback">Please enter a valid recipient email address.</div>
              </div>
              <div class="form-floating mb-3">
                <input type="number" step="0.01" min="0.01" max="<%= user.balance %>" class="form-control" id="transferAmount" name="amount" placeholder="0.00" required>
                <label for="transferAmount">Transfer Amount ($)</label>
                <div class="invalid-feedback">Please enter a valid transfer amount (not exceeding your balance).</div>
              </div>
              <button type="submit" class="btn btn-primary-custom w-100 py-2 d-flex align-items-center justify-content-center">
                <i class="bi bi-arrow-left-right me-2"></i> Execute Wire Transfer
              </button>
            </form>
          </div>
        </div>
      </div>

      <!-- Recent Transactions Section -->
      <div class="card card-premium p-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <h5 class="fw-bold text-primary mb-0">Recent Transactions</h5>
          <span class="text-muted small">Showing last 10 entries</span>
        </div>

        <div class="table-responsive">
          <table class="table table-transactions align-middle mb-0">
            <thead>
              <tr>
                <th>Date</th>
                <th>Description</th>
                <th>Type</th>
                <th>Status</th>
                <th class="text-end">Amount</th>
              </tr>
            </thead>
            <tbody>
              
              <% if (typeof transactions !== 'undefined' && transactions && transactions.length > 0) { %>
                <% transactions.forEach(function(tx) { %>
                  <tr>
                    <td class="text-muted small">
                      <%= new Date(tx.timestamp).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) %>
                      <br>
                      <span class="text-muted text-opacity-75" style="font-size: 0.75rem;">
                        <%= new Date(tx.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) %>
                      </span>
                    </td>
                    <td>
                      <div class="fw-bold text-dark"><%= tx.description %></div>
                      <span class="small text-muted" style="font-size: 0.75rem;">ID: TX-<%= String(tx.id).padStart(5, '0') %></span>
                    </td>
                    <td>
                      <% if (tx.transaction_type === 'deposit') { %>
                        <span class="badge bg-success-light text-success border border-success border-opacity-25">Deposit</span>
                      <% } else if (tx.transaction_type === 'withdraw') { %>
                        <span class="badge bg-danger-light text-danger border border-danger border-opacity-25">Withdrawal</span>
                      <% } else if (tx.transaction_type === 'transfer_out') { %>
                        <span class="badge bg-warning-light text-warning border border-warning border-opacity-25">Transfer Out</span>
                      <% } else if (tx.transaction_type === 'transfer_in') { %>
                        <span class="badge bg-info-light text-info border border-info border-opacity-25">Transfer In</span>
                      <% } %>
                    </td>
                    <td>
                      <span class="text-success small fw-medium">
                        <i class="bi bi-check-circle-fill me-1"></i> Completed
                      </span>
                    </td>
                    <td class="text-end transaction-amount <%= (tx.transaction_type === 'deposit' || tx.transaction_type === 'transfer_in') ? 'amount-in' : 'amount-out' %>">
                      <%= (tx.transaction_type === 'deposit' || tx.transaction_type === 'transfer_in') ? '+' : '-' %>$<%= parseFloat(tx.amount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center text-muted py-4">
                    <i class="bi bi-card-list fs-2 text-muted mb-2 d-block"></i>
                    No transactions recorded yet.
                  </td>
                </tr>
              <% } %>

            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- Right Column (Session Tracker & Security Details) -->
    <div class="col-lg-4">
      
      <!-- Session Status Widget -->
      <div class="card card-premium session-card active-session p-4 mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <h5 class="fw-bold text-primary mb-0">Session Status</h5>
          <span class="badge bg-success-light text-success fw-bold">Active</span>
        </div>

        <div class="text-center py-3 my-2 bg-light rounded-3">
          <div class="display-6 fw-bold text-primary mb-1" id="sessionTimer">15:00</div>
          <span class="text-muted small text-uppercase fw-semibold tracking-wider">Minutes Remaining</span>
        </div>

        <ul class="list-unstyled small mb-4">
          <li class="d-flex align-items-center justify-content-between py-2 border-bottom">
            <span class="text-muted">Logged-in User:</span>
            <span class="fw-semibold text-dark text-truncate" style="max-width: 180px;" title="<%= sessionInfo.userEmail %>"><%= sessionInfo.userEmail %></span>
          </li>
          <li class="d-flex align-items-center justify-content-between py-2 border-bottom">
            <span class="text-muted">Login Time:</span>
            <span class="fw-semibold text-dark"><%= new Date(sessionInfo.loginTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) %></span>
          </li>
          <li class="d-flex align-items-center justify-content-between py-2 border-bottom">
            <span class="text-muted">Inactivity Timeout:</span>
            <span class="fw-semibold text-dark">15 Minutes</span>
          </li>
          <li class="d-flex align-items-center justify-content-between py-2">
            <span class="text-muted">Tracking Token:</span>
            <code class="text-dark">apt_<%= String(sessionInfo.userId).padStart(4, '0') %>_<%= new Date(sessionInfo.loginTime).getTime().toString(16).slice(-6) %></code>
          </li>
        </ul>

        <!-- Extend Session Button -->
        <button onclick="location.href='/dashboard?extended=true'" class="btn btn-outline-primary w-100 d-flex align-items-center justify-content-center py-2">
          <i class="bi bi-arrow-repeat me-2"></i> Extend Secure Session
        </button>

        <script>
          (function() {
            const loginTime = new Date("<%= sessionInfo.loginTime %>").getTime();
            const timeoutMs = 15 * 60 * 1000;
            const expireTime = loginTime + timeoutMs;

            function updateTimer() {
              const now = Date.now();
              const remainingMs = expireTime - now;

              if (remainingMs <= 0) {
                document.getElementById('sessionTimer').innerText = "00:00";
                clearInterval(interval);
                window.location.href = '/dashboard';
                return;
              }

              const totalSec = Math.floor(remainingMs / 1000);
              const mins = Math.floor(totalSec / 60);
              const secs = totalSec % 60;
              document.getElementById('sessionTimer').innerText = 
                (mins < 10 ? '0' : '') + mins + ':' + (secs < 10 ? '0' : '') + secs;
            }

            updateTimer();
            const interval = setInterval(updateTimer, 1000);
          })();
        </script>
      </div>

      <!-- Security Advisory Widget -->
      <div class="card card-premium p-4">
        <h5 class="fw-bold text-primary mb-3">
          <i class="bi bi-shield-shaded text-accent me-1"></i> Security Center
        </h5>
        
        <p class="small text-muted mb-3">
          Your online session is continuously monitored to prevent unauthorized access. If you notice any suspicious activity, freeze your account immediately.
        </p>

        <div class="alert alert-warning border-0 small mb-0 rounded-3">
          <h6 class="alert-heading fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i> Safety Tip</h6>
          ApexTrust will never ask for your account password or session token via email or SMS.
        </div>
      </div>

    </div>

  </div>
</div>

<script>
  (function () {
    'use strict'
    var forms = document.querySelectorAll('.needs-validation')
    Array.prototype.slice.call(forms).forEach(function (form) {
      form.addEventListener('submit', function (event) {
        if (!form.checkValidity()) {
          event.preventDefault()
          event.stopPropagation()
        }
        form.classList.add('was-validated')
      }, false)
    })
  })()
</script>

<%- include('partials/footer') %>

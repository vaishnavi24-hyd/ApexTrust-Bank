<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'ApexTrust Bank' %></title>
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <!-- Custom Stylesheet -->
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <!-- Premium Banking Navigation Bar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-navy sticky-top shadow-sm py-3">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center" href="/">
        <span class="brand-icon me-2">
          <i class="bi bi-shield-fill-check"></i>
        </span>
        <span class="brand-text">ApexTrust <span class="text-accent">Bank</span></span>
      </a>
      
      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#bankingNavbar" aria-controls="bankingNavbar" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="bankingNavbar">
        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
          <li class="nav-item px-1">
            <a class="nav-link d-flex align-items-center <%= (typeof activePage !== 'undefined' && activePage === 'dashboard') ? 'active' : '' %>" href="/dashboard">
              <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
          </li>
          <li class="nav-item px-1">
            <a class="nav-link d-flex align-items-center <%= (typeof activePage !== 'undefined' && activePage === 'login') ? 'active' : '' %>" href="/login">
              <i class="bi bi-box-arrow-in-right me-1"></i> Login
            </a>
          </li>
          <li class="nav-item px-1">
            <a class="nav-link d-flex align-items-center <%= (typeof activePage !== 'undefined' && activePage === 'register') ? 'active' : '' %>" href="/register">
              <i class="bi bi-person-plus me-1"></i> Register
            </a>
          </li>
          <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
            <a href="/login" class="btn btn-outline-accent btn-sm px-3 rounded-pill">
              <i class="bi bi-lock me-1"></i> Secure Portal
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <main class="flex-grow-1 py-5">

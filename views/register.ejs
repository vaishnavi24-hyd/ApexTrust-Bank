<%- include('partials/header') %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
      
      <!-- Accent Header -->
      <div class="text-center mb-4">
        <div class="icon-circle icon-success mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.75rem;">
          <i class="bi bi-person-plus-fill"></i>
        </div>
        <h2 class="fw-bold text-dark">Register for Online Banking</h2>
        <p class="text-muted">Create an account to securely track your sessions, balance, and transactions</p>
      </div>

      <!-- Main Registration Card -->
      <div class="card card-premium p-4 p-md-5">
        
        <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
          <div class="alert alert-danger mb-4 rounded-3 small" role="alert">
            <ul class="mb-0 ps-3">
              <% errors.forEach(function(err) { %>
                <li><%= err.msg %></li>
              <% }); %>
            </ul>
          </div>
        <% } %>

        <form action="/auth/register" method="POST" class="needs-validation" novalidate>
          
          <h5 class="fw-semibold text-primary mb-3 border-bottom pb-2">Personal Information</h5>
          <div class="row g-3 mb-4">
            <!-- Full Name -->
            <div class="col-md-6">
              <div class="form-floating">
                <input type="text" class="form-control" id="fullName" name="fullname" placeholder="Full Name" value="<%= typeof values !== 'undefined' && values.fullname ? values.fullname : '' %>" required>
                <label for="fullName">Full Name</label>
                <div class="invalid-feedback">Please enter your full name.</div>
              </div>
            </div>
            <!-- Email Address -->
            <div class="col-md-6">
              <div class="form-floating">
                <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com" value="<%= typeof values !== 'undefined' && values.email ? values.email : '' %>" required>
                <label for="email">Email Address</label>
                <div class="invalid-feedback">Please enter a valid email address.</div>
              </div>
            </div>
          </div>

          <h5 class="fw-semibold text-primary mb-3 border-bottom pb-2">Account Specifications</h5>
          <div class="row g-3 mb-4">
            <!-- Preferred Account Type -->
            <div class="col-md-6">
              <div class="form-floating">
                <select class="form-select" id="accountType" name="accountType" required>
                  <option value="" disabled <%= typeof values === 'undefined' || !values.accountType ? 'selected' : '' %>>Select Account Type</option>
                  <option value="checking" <%= typeof values !== 'undefined' && values.accountType === 'checking' ? 'selected' : '' %>>Checking Account</option>
                  <option value="savings" <%= typeof values !== 'undefined' && values.accountType === 'savings' ? 'selected' : '' %>>Savings Account</option>
                  <option value="business" <%= typeof values !== 'undefined' && values.accountType === 'business' ? 'selected' : '' %>>Business Account</option>
                </select>
                <label for="accountType">Account Type</label>
                <div class="invalid-feedback">Please select an account type.</div>
              </div>
            </div>
            <!-- Customer Reference Number -->
            <div class="col-md-6">
              <div class="form-floating">
                <input type="text" class="form-control" id="refNumber" name="refNumber" placeholder="Reference Number (Optional)" value="<%= typeof values !== 'undefined' && values.refNumber ? values.refNumber : '' %>">
                <label for="refNumber">Existing Ref / Account # (Optional)</label>
              </div>
            </div>
          </div>

          <h5 class="fw-semibold text-primary mb-3 border-bottom pb-2">Security Credentials</h5>
          <div class="row g-3 mb-4">
            <!-- Password -->
            <div class="col-md-6">
              <div class="form-floating">
                <input type="password" class="form-control" id="registerPassword" name="password" placeholder="Create Password" required>
                <label for="registerPassword">Create Password</label>
                <div class="invalid-feedback">Please create a secure password.</div>
              </div>
            </div>
            <!-- Confirm Password -->
            <div class="col-md-6">
              <div class="form-floating">
                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Confirm Password" required>
                <label for="confirmPassword">Confirm Password</label>
                <div class="invalid-feedback">Passwords must match.</div>
              </div>
            </div>
          </div>

          <!-- Terms and Agreements -->
          <div class="mb-4">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="termsCheck" required checked>
              <label class="form-check-label text-muted small" for="termsCheck">
                I agree to the <a href="#" class="text-accent text-decoration-none fw-medium">Electronic Banking Disclosures</a> and authorize session tracing for security verification.
              </label>
              <div class="invalid-feedback">You must agree before submitting.</div>
            </div>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="btn btn-primary-custom w-100 py-3 d-flex align-items-center justify-content-center">
            <i class="bi bi-person-check-fill me-2"></i> Register Account
          </button>
        </form>
      </div>

      <!-- Login Redirect Navigation -->
      <div class="text-center mt-4">
        <p class="text-muted small">
          Already registered for online access? 
          <a href="/login" class="text-accent text-decoration-none fw-semibold">Access Secure Login</a>
        </p>
      </div>

    </div>
  </div>
</div>

<%- include('partials/footer') %>

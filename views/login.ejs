<%- include('partials/header') %>

<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 col-xl-5">
      
      <!-- Brand Accent Icon for Login -->
      <div class="text-center mb-4">
        <div class="icon-circle icon-primary mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.75rem;">
          <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h2 class="fw-bold text-dark">Welcome Back</h2>
        <p class="text-muted">Enter your credentials to access your secure portal</p>
      </div>

      <!-- Main Login Card -->
      <div class="card card-premium p-4 p-md-5">
        
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger d-flex align-items-center mb-4 rounded-3 small" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div><%= error %></div>
          </div>
        <% } %>

        <form action="/dashboard" method="GET" class="needs-validation" novalidate>
          
          <!-- Customer ID / Email Field -->
          <div class="form-floating mb-3">
            <input type="text" class="form-control" id="customerId" placeholder="Customer ID or Email" required>
            <label for="customerId">Customer ID or Email</label>
            <div class="invalid-feedback">
              Please enter your Customer ID or Email address.
            </div>
          </div>

          <!-- Password Field -->
          <div class="form-floating mb-3">
            <input type="password" class="form-control" id="password" placeholder="Password" required>
            <label for="password">Password</label>
            <div class="invalid-feedback">
              Please enter your account password.
            </div>
          </div>

          <!-- Remember Me & Forgot Password -->
          <div class="d-flex align-items-center justify-content-between mb-4 small">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="rememberMe">
              <label class="form-check-label text-muted" for="rememberMe">
                Remember Customer ID
              </label>
            </div>
            <a href="#" class="text-accent text-decoration-none fw-medium">Forgot Password?</a>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="btn btn-primary-custom w-100 py-3 d-flex align-items-center justify-content-center">
            <i class="bi bi-lock-fill me-2"></i> Log In Securely
          </button>
        </form>

        <!-- Guarantee Notice -->
        <div class="mt-4 pt-3 border-top text-center text-muted small">
          <i class="bi bi-shield-fill-check text-success me-1"></i>
          Guaranteed 256-bit SSL Data Encryption
        </div>
      </div>

      <!-- Registration Navigation Prompts -->
      <div class="text-center mt-4">
        <p class="text-muted small">
          Don't have an online banking account? 
          <a href="/register" class="text-accent text-decoration-none fw-semibold">Register for Online Access</a>
        </p>
      </div>

    </div>
  </div>
</div>

<%- include('partials/footer') %>
